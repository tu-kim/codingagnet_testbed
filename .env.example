# --- OpenCode ---
OPENCODE_PORT=4096
OPENCODE_HOST=127.0.0.1
OPENCODE_EXPERIMENTAL_WORKSPACES=true
OPENCODE_SERVER_PASSWORD=

# --- Dynamo frontend (OpenAI-compatible) ---
DYNAMO_PORT=8000
DYNAMO_BASE_URL=http://127.0.0.1:8000/v1
DYNAMO_API_KEY=local
ROUTER_MODE=kv

# --- Model / vLLM (placeholder; set per host) ---
# Dynamo 1.1 ships with vLLM 0.19.0
MODEL_NAME=
VLLM_IMAGE=vllm/vllm-openai:v0.19.0

# --- Tracing ---
# OTLP/HTTP endpoint (path /v1/traces is required for HTTP transport).
OTLP_HTTP_ENDPOINT=http://127.0.0.1:4318/v1/traces
JAEGER_QUERY_URL=http://127.0.0.1:16686

# --- Workspace root for OpenCode multi-tenant requests ---
WORKSPACE_ROOT=./results/_workspaces

# --- Discovery (Dynamo 1.1, local single-node) ---
DISCOVERY_BACKEND=file
NATS_ADDR=nats://127.0.0.1:4222
