# Worker topology — edit and copy to deploy/workers.env

# Common
MODEL_NAME=
# Dynamo 1.1 ships with vLLM 0.19.0; pin the image accordingly if running in containers.
VLLM_IMAGE=vllm/vllm-openai:v0.19.0
KV_CONNECTOR=NixlConnector             # or P2pNcclConnector / MooncakeConnector
EXTRA_VLLM_ARGS="--enable-prefix-caching"

# Slot syntax: "name:gpus:tp:pp[:extra_args]"
#   name       — used as OTEL_SERVICE_NAME suffix and dynamo worker id
#   gpus       — comma-separated CUDA_VISIBLE_DEVICES (e.g. "0,1")
#   tp         — --tensor-parallel-size
#   pp         — --pipeline-parallel-size
#   extra_args — appended verbatim to `vllm serve` (quote spaces with %20 or use single token)
#
# Slots are whitespace-separated.

PREFILL_WORKERS="p0:0:1:1"
DECODE_WORKERS="d0:1:1:1"

# OTLP/HTTP (path /v1/traces is part of the URL for HTTP transport)
OTLP_HTTP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Dynamo discovery (local single-node = file)
DISCOVERY_BACKEND=file
