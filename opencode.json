{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Dynamo",
      "options": {
        "baseURL": "{env:DYNAMO_BASE_URL}",
        "apiKey": "{env:DYNAMO_API_KEY}"
      },
      "models": {
        "{env:MODEL_NAME}": { "name": "Local model via Dynamo" }
      }
    }
  },
  "model": "local/{env:MODEL_NAME}"
}
