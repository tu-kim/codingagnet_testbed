{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Dynamo",
      "options": {
        "baseURL": "${DYNAMO_BASE_URL}",
        "apiKey": "${DYNAMO_API_KEY}"
      },
      "models": {
        "${MODEL_NAME}": { "name": "Local model via Dynamo" }
      }
    }
  },
  "model": "local/${MODEL_NAME}"
}
